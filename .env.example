# AI-IDS Step 8 notification configuration
# Copy this file to .env only if your shell or process manager loads .env files,
# or export the variables directly before starting src/live_monitor.py.
# Never commit real credentials or webhook URLs.

# Comma-separated: console,desktop,telegram,discord,email
AI_IDS_NOTIFY_CHANNELS=console

# Telegram
AI_IDS_TELEGRAM_BOT_TOKEN=
AI_IDS_TELEGRAM_CHAT_ID=

# Discord webhook
AI_IDS_DISCORD_WEBHOOK_URL=

# SMTP email
AI_IDS_SMTP_HOST=smtp.gmail.com
AI_IDS_SMTP_PORT=587
AI_IDS_SMTP_USERNAME=
AI_IDS_SMTP_PASSWORD=
AI_IDS_EMAIL_FROM=
AI_IDS_EMAIL_TO=
AI_IDS_SMTP_SSL=false
AI_IDS_SMTP_STARTTLS=true
